{
  "detect": {
    "files": [
      "build.gradle",
      "build.gradle.kts",
      "settings.gradle",
      "settings.gradle.kts",
      "pom.xml"
    ],
    "suffixes": [
      ".kt",
      ".kts",
      ".java"
    ]
  },
  "skip_dirs": [
    ".gradle"
  ],
  "formatters": [
    "ktlint"
  ],
  "linters": [
    "ktlint"
  ],
  "code_suffixes": [
    ".java",
    ".kt"
  ],
  "ci_test": [
    "\\bgradlew?\\b.*\\b(test|check)\\b",
    "\\bmvn\\b.*\\b(test|verify)\\b"
  ],
  "app_decl": [
    [
      "build.gradle",
      "com\\.android\\.application"
    ],
    [
      "build.gradle.kts",
      "com\\.android\\.application"
    ],
    [
      "app/build.gradle",
      "com\\.android\\.application"
    ],
    [
      "app/build.gradle.kts",
      "com\\.android\\.application"
    ]
  ],
  "app_paths": [
    "android"
  ]
}
