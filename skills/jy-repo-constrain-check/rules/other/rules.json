{
  "detect": {
    "files": [
      "Gemfile",
      "pubspec.yaml",
      "CMakeLists.txt"
    ],
    "globs": [
      "*.csproj",
      "*.sln"
    ],
    "suffixes": [
      ".rb",
      ".c",
      ".cc",
      ".cpp",
      ".h",
      ".hpp",
      ".cs",
      ".dart"
    ]
  },
  "formatters": [
    "clang-format",
    "stylua"
  ],
  "linters": [
    "rubocop"
  ],
  "code_suffixes": [
    ".rb",
    ".c",
    ".cc",
    ".cpp"
  ],
  "ci_test": [
    "\\bdotnet test\\b",
    "\\brspec\\b"
  ],
  "cli_code": [
    "\\bOptionParser\\b"
  ],
  "app_decl": [
    [
      "Gemfile",
      "\\brails\\b"
    ],
    [
      "pubspec.yaml",
      "(?m)^\\s*sdk:\\s*flutter\\b"
    ]
  ],
  "app_paths": [
    "app/views"
  ]
}
