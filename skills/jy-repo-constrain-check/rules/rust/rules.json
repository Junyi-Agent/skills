{
  "detect": {
    "files": [
      "Cargo.toml"
    ],
    "suffixes": [
      ".rs"
    ]
  },
  "skip_dirs": [
    "target"
  ],
  "formatters": [
    "rustfmt",
    "cargo fmt"
  ],
  "linters": [
    "clippy"
  ],
  "strict": [
    "-D\\s*warnings",
    "--deny[= ]warnings"
  ],
  "lint_configs": [
    "clippy.toml",
    ".clippy.toml",
    "Cargo.toml"
  ],
  "code_suffixes": [
    ".rs"
  ],
  "ci_lint": [
    "clippy"
  ],
  "ci_test": [
    "cargo test"
  ],
  "cli_code": [
    "\\bclap::"
  ],
  "cli_decl": [
    [
      "Cargo.toml",
      "(?m)^\\[\\[bin\\]\\]"
    ]
  ],
  "lib_decl": [
    [
      "Cargo.toml",
      "(?m)^\\[lib\\]"
    ]
  ]
}
